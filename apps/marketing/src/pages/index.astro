  .multi-chat-visual,
  .context-attach-visual,
  .integrated-panel-visual {
    background: #09090b url("/hero-monet.webp") center 42% / cover no-repeat;
  }

  .multi-chat-visual::before,
  .context-attach-visual::before,
  .integrated-panel-visual::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
