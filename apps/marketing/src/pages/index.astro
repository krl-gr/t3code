    box-shadow: 0 32px 70px rgba(0, 0, 0, 0.62);
  }

  .crop-left img { left: 8%; }
  .crop-center img { left: 50%; transform: translateX(-50%); }
  .crop-right img { right: 8%; }

  .preview-head {
    padding: 58px 48px 46px;
    border-bottom: 1px solid var(--border-strong);
  }

  .preview-head p {
    margin-top: 16px;
    color: var(--fg-muted);
  }

  .preview-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
  }

  .preview-card {
    padding: 46px;
    border-left: 1px solid var(--border-strong);
  }

  .preview-card:first-child { border-left: 0; }

  .preview-card h3 {
    margin-top: 28px;
    font-size: 20px;
    font-weight: 500;
  }

  .preview-card > p {
    margin-top: 10px;
    color: var(--fg-muted);
    font-size: 14px;
  }

  .preview-placeholder {
    height: 170px;
    position: relative;
    overflow: hidden;
    border: 1px solid var(--border-strong);
    background: #111114;
  }

  .node-preview i {
    position: absolute;
    width: 76px;
    height: 54px;
    border: 1px solid var(--border-strong);
    background: #19191d;
  }
  .node-preview i:nth-child(1) { left: 18%; top: 24%; transform: rotate(-4deg); }
