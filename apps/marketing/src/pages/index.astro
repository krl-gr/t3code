  }

  .feature-app-frame {
    position: absolute;
    inset: 7% 6%;
    z-index: 1;
    overflow: hidden;
    border: 1px solid rgba(255,255,255,.18);
    border-radius: 16px;
    box-shadow: 0 40px 90px rgba(0,0,0,.65);
  }

  .feature-visual img {
    position: absolute;
    top: 9%;
    height: 82%;
    width: auto;
