  .agent-capabilities svg {
    width: 12px;
    height: 12px;
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.5;
  }

  .harness-lines {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
  }

  .harness-lines path {
    fill: none;
    stroke: rgba(255, 255, 255, 0.16);
    stroke-width: 1;
    stroke-dasharray: 4 5;
  }

  .harness-center,
  .harness-node,
  .harness-orchestration {
    position: absolute;
    z-index: 2;
  }

  .harness-center {
    top: 50%;
    left: 50%;
    width: 62px;
    height: 62px;
    padding: 7px;
    transform: translate(-50%, -50%);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 16px;
    background: #15151a;
    box-shadow: 0 0 52px rgba(112, 82, 255, 0.36);
  }

  .harness-center img {
    width: 100%;
    height: 100%;
    border-radius: 10px;
  }

  .harness-node {
    width: 116px;
    height: 54px;
    padding: 0 12px;
    display: flex;
    align-items: center;
    gap: 9px;
    border: 1px solid var(--border-strong);
    background: rgba(17, 17, 20, 0.9);
    color: var(--fg-muted);
    font-size: 10px;
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.25);
  }

  .harness-node img,
  .harness-more {
    width: 22px;
    height: 22px;
    flex: none;
    object-fit: contain;
  }

  .harness-more {
    display: grid;
    place-items: center;
    border: 1px solid var(--border-strong);
    border-radius: 6px;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 9px;
  }

  .harness-node--claude { top: 15%; left: 6%; }
  .harness-node--codex { top: 15%; right: 6%; }
  .harness-node--opencode { bottom: 15%; left: 6%; }
  .harness-node--more { right: 6%; bottom: 15%; }

  .harness-orchestration {
    left: 50%;
    bottom: 16px;
    padding: 5px 9px;
    transform: translateX(-50%);
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    background: #0d0d10;
    color: var(--fg-dim);
    font-family: var(--font-mono);
    font-size: 9px;
