    font-family: var(--font-mono);
    font-size: 11px;
  }

  .feature-copy p {
    max-width: 310px;
    margin-top: 22px;
    color: var(--fg-muted);
    font-size: 16px;
  }

  .feature-visual {
    position: relative;
    min-width: 0;
    overflow: hidden;
