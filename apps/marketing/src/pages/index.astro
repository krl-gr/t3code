  }

  .grok-list-icon svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .cursor-list-icon img {
    filter: invert(1);
    opacity: .88;
  }

  .choice-list.choice-list--harnesses li > .more-list-icon {
    border: 1px solid var(--border-strong);
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 9px;
  }

  .agent-visual {
    padding: 30px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .agent-visual-topline {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 9px;
    color: var(--fg-muted);
    font-family: var(--font-mono);
    font-size: 11px;
  }

  .agent-pulse {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--ok);
    box-shadow: 0 0 16px color-mix(in srgb, var(--ok) 70%, transparent);
  }

  .agent-byok {
    margin-left: auto;
    padding: 4px 8px;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    color: var(--fg-dim);
    font-size: 9px;
    letter-spacing: 0.08em;
  }

  .agent-metrics {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }

  .agent-metric {
    min-width: 0;
    padding: 22px 18px;
    border: 1px solid var(--border-strong);
    background: rgba(17, 17, 20, 0.78);
    backdrop-filter: blur(8px);
  }

  .agent-metric strong {
    display: block;
    color: #fff;
    font-size: clamp(34px, 4vw, 52px);
    font-weight: 500;
    letter-spacing: -0.055em;
