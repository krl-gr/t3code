  }

  .agent-metric span {
    display: block;
    margin-top: 10px;
    color: var(--fg-muted);
    font-size: 11px;
  }

  .agent-capabilities {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .agent-capabilities span {
    padding: 7px 10px;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    background: rgba(9, 9, 11, 0.72);
    color: var(--fg-muted);
    font-size: 10px;
