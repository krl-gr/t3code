---
import Layout from "../layouts/Layout.astro";
import TuxIcon from "../components/TuxIcon.astro";
---

<Layout
  title="Up.computer — GUI for coding CLIs"
  description="Up.computer is the desktop GUI for Codex CLI, Cursor CLI, Pi, OpenCode, and the coding agents you already run."
>
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-copy">
        <p class="eyebrow">Up.computer alpha</p>
        <h1 class="display hero-title">The best GUI for your coding CLIs.</h1>
        <p class="hero-sub">
          Run Codex CLI, Cursor CLI, Pi, OpenCode, and the next agent you try from one
          desktop workspace. Keep your CLIs. Add threads, terminals, diffs, branches,
          and pull requests around them.
        </p>

        <div class="hero-actions">
          <a
            id="download-btn"
            href="https://github.com/krl-gr/t3code/releases"
            class="btn btn-primary btn-lg"
          >
            <svg class="dl-icon dl-icon--apple" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 814 1000" aria-hidden="true"><path fill="currentColor" d="M788.1 340.9c-5.8 4.5-108.2 62.2-108.2 190.5 0 148.4 130.3 200.9 134.2 202.2-.6 3.2-20.7 71.9-68.7 141.9-42.8 61.6-87.5 123.1-155.5 123.1s-85.5-39.5-164-39.5c-76.5 0-103.7 40.8-165.9 40.8s-105.6-57-155.5-127C46.7 790.7 0 663 0 541.8c0-194.4 126.4-297.5 250.8-297.5 66.1 0 121.2 43.4 162.7 43.4 39.5 0 101.1-46 176.3-46 28.5 0 130.9 2.6 198.3 99.2zm-234-181.5c31.1-36.9 53.1-88.1 53.1-139.3 0-7.1-.6-14.3-1.9-20.1-50.6 1.9-110.8 33.7-147.1 75.8-28.5 32.4-55.1 83.6-55.1 135.5 0 7.8 1.3 15.6 1.9 18.1 3.2.6 8.4 1.3 13.6 1.3 45.4 0 102.5-30.4 135.5-71.3z"/></svg>
            <svg class="dl-icon dl-icon--windows" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 88 88" aria-hidden="true"><path fill="currentColor" d="m0 12.402 35.687-4.86.016 34.423-35.67.203zm35.67 33.529.028 34.453L.028 75.48.026 45.7zm4.326-39.025L87.314 0v41.527l-47.318.376zm47.329 39.349-.011 41.34-47.318-6.678-.066-34.739z"/></svg>
            <TuxIcon class="dl-icon dl-icon--linux" idPrefix="hero-linux-" />
            <span id="download-label">Download Up.computer</span>
          </a>
          <a
            href="https://github.com/krl-gr/t3code"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-ghost btn-lg"
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 .5C5.65.5.5 5.65.5 12a11.5 11.5 0 007.86 10.93c.58.1.79-.25.79-.56v-2c-3.2.69-3.88-1.37-3.88-1.37-.52-1.33-1.27-1.69-1.27-1.69-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.02 1.76 2.68 1.25 3.33.96.1-.75.4-1.25.72-1.54-2.55-.29-5.24-1.27-5.24-5.67 0-1.25.45-2.28 1.18-3.08-.12-.29-.51-1.45.11-3.02 0 0 .96-.31 3.15 1.18a10.96 10.96 0 015.74 0c2.19-1.49 3.15-1.18 3.15-1.18.62 1.57.23 2.73.11 3.02.74.8 1.18 1.83 1.18 3.08 0 4.41-2.7 5.38-5.27 5.66.41.36.78 1.06.78 2.13v3.16c0 .31.21.67.8.56A11.5 11.5 0 0023.5 12C23.5 5.65 18.35.5 12 .5z"/>
            </svg>
            GitHub
          </a>
        </div>

        <div class="cli-strip" aria-label="Supported coding CLIs">
          <span>Codex CLI</span>
          <span>Cursor CLI</span>
          <span>Pi</span>
          <span>OpenCode</span>
        </div>
      </div>

      <figure class="hero-preview">
        <img
          src="/upcomputer-surface.png"
          alt="Up.computer desktop workspace showing agent threads, changed files, model controls, and source control actions"
          width="1084"
          height="689"
          loading="eager"
          decoding="async"
        />
      </figure>
    </div>
  </section>

  <section class="agent-bar" aria-labelledby="agent-bar-title">
    <div class="container agent-bar-inner">
      <div>
        <p class="eyebrow">Bring your own CLI</p>
        <h2 id="agent-bar-title">One GUI. Every agent runtime you actually use.</h2>
      </div>
      <div class="agent-grid">
        <div class="agent-card">
          <img src="/harnesses/openai_dark.svg" alt="" />
          <div>
            <strong>Codex CLI</strong>
            <span>ChatGPT auth, Codex app server, project threads.</span>
          </div>
        </div>
        <div class="agent-card">
          <img src="/harnesses/cursor_light.svg" alt="" />
          <div>
            <strong>Cursor CLI</strong>
            <span>ACP-style sessions with the same workspace controls.</span>
          </div>
        </div>
        <div class="agent-card agent-card-text">
          <span class="agent-mark">Pi</span>
          <div>
            <strong>Pi</strong>
            <span>Browser-capable agent work with visible runtime state.</span>
          </div>
        </div>
        <div class="agent-card">
          <img src="/harnesses/opencode-dark.svg" alt="" />
          <div>
            <strong>OpenCode</strong>
            <span>Open agent workflows without a separate desktop habit.</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="workflow" aria-labelledby="workflow-title">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Agent work, end to end</p>
        <h2 id="workflow-title">The CLI does the work. Up.computer gives it a cockpit.</h2>
        <p>
          Start a task, watch it run, inspect the diff, and ship the branch without
          rebuilding your workflow around one provider's app.
        </p>
      </div>

      <div class="workflow-grid">
        <article class="workflow-card">
          <span class="step">01</span>
          <h3>Start a thread</h3>
          <p>Pick a repo, branch mode, CLI, model, and permission level before the first prompt.</p>
        </article>
        <article class="workflow-card">
          <span class="step">02</span>
          <h3>Watch the run</h3>
          <p>Approvals, terminal output, context, and agent messages stay in one durable session.</p>
        </article>
        <article class="workflow-card">
          <span class="step">03</span>
          <h3>Review changes</h3>
          <p>Open the changed-file tree and diff viewer instead of reading raw patches in a shell.</p>
        </article>
        <article class="workflow-card">
          <span class="step">04</span>
          <h3>Ship or keep iterating</h3>
          <p>Commit, push, create a pull request, or hand the work back to your editor.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="surface" aria-labelledby="surface-title">
    <div class="container surface-inner">
      <div class="surface-copy">
        <p class="eyebrow">Built around real repo work</p>
        <h2 id="surface-title">Everything around the agent matters.</h2>
        <p>
          Coding CLIs already know how to edit files and run commands. The missing layer is
          the place where you supervise, compare, recover, and ship their work.
        </p>
      </div>

      <div class="surface-grid">
        <div class="surface-item">
          <h3>Project threads</h3>
          <p>Group sessions by repo and keep old work visible instead of losing it in terminal history.</p>
        </div>
        <div class="surface-item">
          <h3>Integrated terminals</h3>
          <p>Open terminals in the session worktree and send selected output back as context.</p>
        </div>
        <div class="surface-item">
          <h3>Visual diffs</h3>
          <p>Review what changed by turn, file, and branch before you trust the result.</p>
        </div>
        <div class="surface-item">
          <h3>Source control</h3>
          <p>Commit, push, publish repos, and open pull requests through the same workspace.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="environments" aria-labelledby="environments-title">
    <div class="container environments-inner">
      <div class="terminal-panel" aria-hidden="true">
        <div class="terminal-head">
          <span></span><span></span><span></span>
          <strong>up.computer</strong>
        </div>
        <div class="terminal-body">
          <div><span>$</span> up connect local</div>
          <p>127.0.0.1:3773 ready</p>
          <div><span>$</span> up connect ssh buildbox</div>
          <p>paired environment, threads synced</p>
          <div><span>$</span> up run codex --worktree feature/login</div>
          <p>thread running, diff tracking enabled</p>
        </div>
      </div>
      <div class="environments-copy">
        <p class="eyebrow">Local first, not local only</p>
        <h2 id="environments-title">Use the machine where the code lives.</h2>
        <p>
          Work locally, expose the desktop backend on your network, or pair an SSH host.
          Up.computer is built for real development setups, not only the happy path on one laptop.
        </p>
        <ul class="checklist">
          <li>Local desktop backend with narrow pairing controls</li>
          <li>Saved environments for remote workspaces</li>
          <li>SSH launch, password prompts, and reconnect handling</li>
          <li>Provider sessions projected into one UI event stream</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="open" aria-labelledby="open-title">
    <div class="container open-inner">
      <div>
        <p class="eyebrow">Early and open</p>
        <h2 id="open-title">The product is young. The code is there.</h2>
        <p>
          Up.computer is still alpha. That means no fake logos, no invented metrics, and no
          borrowed testimonials. Inspect the repo, install the app, and help shape the GUI layer
          around coding CLIs.
        </p>
      </div>
      <div class="open-actions">
        <a class="btn btn-primary" href="https://github.com/krl-gr/t3code/releases">Download</a>
        <a
          class="btn btn-ghost"
          href="https://github.com/krl-gr/t3code"
          target="_blank"
          rel="noopener noreferrer"
        >
          View source
        </a>
      </div>
    </div>
  </section>

  <section id="download" class="final-cta">
    <div class="container final-cta-inner">
      <p class="eyebrow">Download Up.computer</p>
      <h2 class="display">Put your coding agents in one desktop workspace.</h2>
      <p>
        Keep Codex CLI, Cursor CLI, Pi, OpenCode, your editor, and your git workflow.
        Give them a better surface.
      </p>
      <div class="hero-actions">
        <a id="cta-download-btn" class="btn btn-primary btn-lg" href="https://github.com/krl-gr/t3code/releases">
          <svg class="dl-icon dl-icon--apple" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 814 1000" aria-hidden="true"><path fill="currentColor" d="M788.1 340.9c-5.8 4.5-108.2 62.2-108.2 190.5 0 148.4 130.3 200.9 134.2 202.2-.6 3.2-20.7 71.9-68.7 141.9-42.8 61.6-87.5 123.1-155.5 123.1s-85.5-39.5-164-39.5c-76.5 0-103.7 40.8-165.9 40.8s-105.6-57-155.5-127C46.7 790.7 0 663 0 541.8c0-194.4 126.4-297.5 250.8-297.5 66.1 0 121.2 43.4 162.7 43.4 39.5 0 101.1-46 176.3-46 28.5 0 130.9 2.6 198.3 99.2zm-234-181.5c31.1-36.9 53.1-88.1 53.1-139.3 0-7.1-.6-14.3-1.9-20.1-50.6 1.9-110.8 33.7-147.1 75.8-28.5 32.4-55.1 83.6-55.1 135.5 0 7.8 1.3 15.6 1.9 18.1 3.2.6 8.4 1.3 13.6 1.3 45.4 0 102.5-30.4 135.5-71.3z"/></svg>
          <svg class="dl-icon dl-icon--windows" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 88 88" aria-hidden="true"><path fill="currentColor" d="m0 12.402 35.687-4.86.016 34.423-35.67.203zm35.67 33.529.028 34.453L.028 75.48.026 45.7zm4.326-39.025L87.314 0v41.527l-47.318.376zm47.329 39.349-.011 41.34-47.318-6.678-.066-34.739z"/></svg>
          <TuxIcon class="dl-icon dl-icon--linux" idPrefix="cta-linux-" />
          <span id="cta-download-label">Download Up.computer</span>
        </a>
        <a class="btn btn-ghost btn-lg" href="/download">All platforms</a>
      </div>
    </div>
  </section>
</Layout>

<script>
  import { fetchLatestRelease, RELEASES_URL, type ReleaseAsset } from "../lib/releases";

  type Platform = { os: "mac" | "win" | "linux"; label: string; arch?: string };

  function detectPlatform(): Platform | null {
    const ua = navigator.userAgent;
    if (/Win/i.test(ua)) return { os: "win", label: "Download for Windows" };
    if (/Mac/i.test(ua)) return { os: "mac", label: "Download for macOS", arch: "arm64" };
    if (/Linux/i.test(ua)) return { os: "linux", label: "Download for Linux" };
    return null;
  }

  function pickAsset(assets: ReleaseAsset[], platform: Platform): string | null {
    if (platform.os === "win") {
      return assets.find((asset) => asset.name.endsWith("-x64.exe"))?.browser_download_url ?? null;
    }
    if (platform.os === "mac") {
      const preferred = assets.find((asset) => asset.name.endsWith(`-${platform.arch}.dmg`));
      const fallback = assets.find((asset) => asset.name.endsWith(".dmg"));
      return (preferred ?? fallback)?.browser_download_url ?? null;
    }
    if (platform.os === "linux") {
      return assets.find((asset) => asset.name.endsWith(".AppImage"))?.browser_download_url ?? null;
    }
    return null;
  }

  async function init() {
    const btn = document.getElementById("download-btn") as HTMLAnchorElement | null;
    const label = document.getElementById("download-label");
    const ctaBtn = document.getElementById("cta-download-btn") as HTMLAnchorElement | null;
    const ctaLabel = document.getElementById("cta-download-label");
    const platform = detectPlatform();

    if (!platform) return;
    document.documentElement.dataset.platform = platform.os;
    if (label) label.textContent = platform.label;
    if (ctaLabel) ctaLabel.textContent = platform.label;

    try {
      const release = await fetchLatestRelease();
      const url = pickAsset(release.assets ?? [], platform);
      if (!url) return;
      if (btn) btn.href = url;
      if (ctaBtn) ctaBtn.href = url;
    } catch {
      if (btn) btn.href = RELEASES_URL;
      if (ctaBtn) ctaBtn.href = RELEASES_URL;
    }
  }

  init();
</script>

<style>
  section {
    position: relative;
    border-top: 1px solid var(--border);
  }

  .hero {
    border-top: 0;
    padding: 52px 0 28px;
    overflow: hidden;
  }

  .hero-inner {
    display: grid;
    gap: 32px;
  }

  .hero-copy {
    max-width: 880px;
  }

  .hero-title {
    max-width: 820px;
    margin: 14px 0 18px;
    font-size: clamp(44px, 7vw, 88px);
    line-height: 0.98;
    text-wrap: balance;
  }

  .hero-sub {
    max-width: 720px;
    color: var(--fg-muted);
    font-size: clamp(17px, 1.8vw, 21px);
    line-height: 1.45;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 28px;
  }

  .dl-icon {
    display: none;
    width: 14px;
    height: 14px;
    flex-shrink: 0;
  }

  :global([data-platform="mac"]) .dl-icon--apple { display: block; }
  :global([data-platform="win"]) .dl-icon--windows { display: block; }
  :global([data-platform="linux"]) .dl-icon--linux { display: block; }
  :global(:not([data-platform])) .dl-icon--apple { display: block; }

  .cli-strip {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 22px;
  }

  .cli-strip span,
  .step,
  .agent-mark {
    font-family: var(--font-mono);
  }

  .cli-strip span {
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 6px 10px;
    color: var(--fg-muted);
    font-size: 12px;
    background: rgba(255, 255, 255, 0.018);
  }

  .hero-preview {
    height: clamp(300px, 42vw, 540px);
    overflow: hidden;
    border: 1px solid var(--border-strong);
    border-radius: 10px;
    background: #0b0b0d;
    box-shadow: 0 32px 84px -44px rgba(0, 0, 0, 0.9);
  }

  .hero-preview img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 58%;
  }

  .agent-bar {
    padding: 32px 0;
    background: color-mix(in srgb, var(--bg-card) 62%, var(--bg));
  }

  .agent-bar-inner {
    display: grid;
    grid-template-columns: minmax(240px, 0.8fr) minmax(0, 1.4fr);
    gap: 28px;
    align-items: start;
  }

  .agent-bar h2,
  .section-head h2,
  .surface-copy h2,
  .environments-copy h2,
  .open h2,
  .final-cta h2 {
    margin-top: 10px;
    font-size: clamp(30px, 4vw, 52px);
    line-height: 1.05;
    font-weight: 500;
    text-wrap: balance;
  }

  .agent-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
  }

  .agent-card {
    display: grid;
    grid-template-columns: 38px minmax(0, 1fr);
    gap: 12px;
    align-items: center;
    min-height: 94px;
    padding: 14px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.018);
  }

  .agent-card img,
  .agent-mark {
    width: 38px;
    height: 38px;
    border-radius: 8px;
    border: 1px solid var(--border);
    background: #151519;
  }

  .agent-card img {
    padding: 8px;
    object-fit: contain;
  }

  .agent-mark {
    display: grid;
    place-items: center;
    color: var(--fg);
    font-size: 13px;
    font-weight: 600;
  }

  .agent-card strong {
    display: block;
    margin-bottom: 4px;
    font-size: 14px;
  }

  .agent-card span:not(.agent-mark) {
    display: block;
    color: var(--fg-dim);
    font-size: 12px;
    line-height: 1.35;
  }

  .workflow,
  .surface,
  .environments,
  .open,
  .final-cta {
    padding: 88px 0;
  }

  .section-head {
    max-width: 780px;
    margin-bottom: 32px;
  }

  .section-head p,
  .surface-copy p,
  .environments-copy p,
  .open p,
  .final-cta p {
    margin-top: 14px;
    color: var(--fg-muted);
    font-size: 17px;
    line-height: 1.55;
  }

  .workflow-grid,
  .surface-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
  }

  .workflow-card,
  .surface-item {
    min-height: 190px;
    padding: 18px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.025), rgba(255, 255, 255, 0.008));
  }

  .step {
    color: var(--accent);
    font-size: 12px;
  }

  .workflow-card h3,
  .surface-item h3 {
    margin-top: 22px;
    font-size: 19px;
    font-weight: 600;
  }

  .workflow-card p,
  .surface-item p {
    margin-top: 10px;
    color: var(--fg-muted);
    font-size: 14px;
    line-height: 1.5;
  }

  .surface {
    background: color-mix(in srgb, var(--bg-card) 48%, var(--bg));
  }

  .surface-inner,
  .environments-inner,
  .open-inner {
    display: grid;
    grid-template-columns: minmax(260px, 0.72fr) minmax(0, 1fr);
    gap: 40px;
    align-items: start;
  }

  .surface-copy {
    position: sticky;
    top: 92px;
  }

  .surface-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .surface-item {
    min-height: 210px;
  }

  .environments-inner {
    align-items: center;
  }

  .terminal-panel {
    border: 1px solid var(--border-strong);
    border-radius: 8px;
    overflow: hidden;
    background: #08090b;
    box-shadow: 0 24px 70px -46px rgba(0, 0, 0, 0.9);
  }

  .terminal-head {
    display: flex;
    align-items: center;
    gap: 7px;
    border-bottom: 1px solid var(--border);
    padding: 11px 14px;
    color: var(--fg-dim);
    font-family: var(--font-mono);
    font-size: 12px;
  }

  .terminal-head span {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #33343a;
  }

  .terminal-head strong {
    margin-left: auto;
    font-weight: 500;
  }

  .terminal-body {
    padding: 20px;
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.65;
  }

  .terminal-body span {
    color: var(--accent);
    margin-right: 8px;
  }

  .terminal-body p {
    margin: 0 0 10px 20px;
    color: var(--fg-dim);
  }

  .checklist {
    display: grid;
    gap: 10px;
    margin-top: 22px;
    padding: 0;
    list-style: none;
  }

  .checklist li {
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 10px 12px;
    color: var(--fg-muted);
    font-size: 14px;
    background: rgba(255, 255, 255, 0.014);
  }

  .open {
    background: #0b0c0f;
  }

  .open-inner {
    align-items: center;
  }

  .open-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    justify-content: flex-end;
  }

  .final-cta {
    text-align: center;
    border-bottom: 1px solid var(--border);
  }

  .final-cta-inner {
    display: grid;
    justify-items: center;
  }

  .final-cta h2 {
    max-width: 840px;
    font-size: clamp(40px, 6vw, 76px);
  }

  .final-cta p {
    max-width: 660px;
  }

  @media (max-width: 980px) {
    .agent-bar-inner,
    .surface-inner,
    .environments-inner,
    .open-inner {
      grid-template-columns: 1fr;
    }

    .surface-copy {
      position: static;
    }

    .workflow-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 720px) {
    .hero {
