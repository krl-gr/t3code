  .choice-list {
    margin: 30px 0 0;
    padding: 0;
    border-top: 1px solid var(--border-strong);
    list-style: none;
  }

  .choice-list li {
    min-height: 56px;
    padding: 14px 4px;
    display: flex;
    align-items: center;
    gap: 13px;
    border-bottom: 1px solid var(--border-strong);
    color: rgba(255,255,255,.82);
    font-size: 16px;
    line-height: 1.5;
  }

  .choice-list li > span {
    width: 7px;
    height: 7px;
    flex: none;
