    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .choice-card {
    min-width: 0;
    padding: 46px;
    border-left: 1px solid var(--border-strong);
  }

  .choice-card:first-child {
    border-left: 0;
  }

  .choice-visual {
    position: relative;
    height: 350px;
