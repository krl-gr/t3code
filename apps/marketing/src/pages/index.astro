  .showcase-head h2,
  .preview-head h2,
  .feature-copy h2 {
    font-size: clamp(30px, 4vw, 52px);
    line-height: 1;
    letter-spacing: -0.04em;
    font-weight: 500;
  }

  .feature-copy h2 {
    font-size: clamp(30px, 3vw, 42px);
    line-height: 1.04;
  }

  .complexity-control {
