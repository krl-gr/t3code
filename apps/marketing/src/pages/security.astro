---
import LegalPage from "../components/LegalPage.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout title="Security · Up.computer" description="Report an Up.computer security issue.">
  <LegalPage
    title="Security"
    description="Help us handle security issues privately and responsibly."
    effectiveDate="July 16, 2026"
  >
    <h2>Report privately</h2>
    <p>
      Send suspected vulnerabilities to
      <a href="mailto:support@up.computer">support@up.computer</a>. Do not publish exploit details,
      credentials, or personal data in a GitHub issue.
    </p>
    <p>
      Include the affected version, operating system, reproduction steps, expected impact, and any
      suggested mitigation. Do not access data that is not yours, disrupt services, or perform
      destructive testing.
    </p>

    <h2>Support policy</h2>
    <p>
      Security fixes are normally shipped in the latest release. Older releases are not
      guaranteed to receive backports. No fixed response or remediation deadline is promised yet,
      but good-faith reports are welcome and will be reviewed.
    </p>
  </LegalPage>
</Layout>
