---
import MiniPaneComposer from "./MiniPaneComposer.astro";
---

<div class="multi-chat-viewport" data-multi-chat-viewport aria-hidden="true" inert>
  <div class="multi-chat-app">
    <aside class="multi-sidebar">
      <div class="traffic-lights" aria-hidden="true"><i></i><i></i><i></i></div>

      <nav class="sidebar-nav">
        <div><svg viewBox="0 0 24 24"><path d="M9 11l2 2 4-4M4 6h2M4 12h2M4 18h2M9 6h11M9 18h11"></path></svg><span>Tasks</span></div>
        <div><svg viewBox="0 0 24 24"><rect x="4" y="7" width="16" height="12" rx="2"></rect><path d="M9 7V4h6v3M8 12v3M16 12v3"></path></svg><span>Agents</span></div>
        <div><svg viewBox="0 0 24 24"><path d="M5 12h13M13 6l6 6-6 6"></path></svg><span>Classic view</span></div>
      </nav>

      <div class="sidebar-scroll">
        <div class="sidebar-section"><span>Projects</span><svg class="section-chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg></div>
        <div class="project active"><i class="project-icon orange">A</i><span>Acme App</span></div>
        <div class="project"><i class="project-icon mint">D</i><span>Developer Portal</span></div>
        <div class="project"><i class="project-icon violet">S</i><span>SDK</span></div>
        <div class="project"><span class="more">•••</span><span>More</span></div>

        <div class="sidebar-section threads"><span>Acme App threads</span><svg class="section-chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg></div>
        <div class="thread"><span>Prepare release candidate</span><time>1h</time></div>
        <div class="thread"><span>Implement billing portal</span><time>2h</time></div>
        <div class="thread"><span>Review API migration</span><time>5h</time></div>
        <div class="thread"><span>Compare provider integrations</span><time>5h</time></div>
        <div class="thread"><span>Add onboarding analytics</span><time>5h</time></div>
        <div class="thread"><span>Refine task creation flow</span><time>6h</time></div>
        <div class="thread"><span>Document deployment architecture</span><time>10h</time></div>
        <div class="thread"><span>Polish theme settings</span><time>1d</time></div>
        <div class="thread"><span>Plan workspace orchestration</span><time>1d</time></div>
        <div class="thread"><span>Separate metadata and content</span><time>1d</time></div>
        <div class="thread"><span>Document orchestration layer</span><time>2d</time></div>
      </div>

      <div class="sidebar-settings">
        <svg viewBox="0 0 24 24"><path d="M9.671 4.136a2.34 2.34 0 0 1 4.659 0 2.34 2.34 0 0 0 3.319 1.915 2.34 2.34 0 0 1 2.33 4.033 2.34 2.34 0 0 0 0 3.831 2.34 2.34 0 0 1-2.33 4.033 2.34 2.34 0 0 0-3.319 1.915 2.34 2.34 0 0 1-4.659 0 2.34 2.34 0 0 0-3.32-1.915 2.34 2.34 0 0 1-2.33-4.033 2.34 2.34 0 0 0 0-3.831A2.34 2.34 0 0 1 6.35 6.051a2.34 2.34 0 0 0 3.319-1.915"></path><circle cx="12" cy="12" r="3"></circle></svg>
        <span>Settings</span>
      </div>
    </aside>

    <main class="pane-grid">
      <section class="chat-pane">
        <header><span class="panel-symbol"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="3"></rect><path d="M8 4v16"></path></svg></span><strong>Plan workspace orchestration</strong><span class="pane-actions"><svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"></path></svg><svg viewBox="0 0 24 24"><path d="m6 6 12 12M18 6 6 18"></path></svg></span></header>
        <div class="chat-scroll">
          <p class="worked">Worked for 2m 54s　›</p>
          <p><b>The workspace orchestration plan is ready for review.</b></p>
          <p>Proposed shape:</p>
          <ul><li>Give each task a clear owner.</li><li>Show progress across parallel threads.</li><li>Keep Build, Ask, and Plan available per thread.</li></ul>
        </div>
        <MiniPaneComposer mode="Ask" placeholder="Ask anything" />
      </section>

      <section class="chat-pane">
        <header><strong>Prepare release candidate</strong><span class="pane-actions"><svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"></path></svg><svg viewBox="0 0 24 24"><path d="m6 6 12 12M18 6 6 18"></path></svg></span></header>
        <div class="chat-scroll">
          <p class="worked">Worked for 1m 54s　›</p>
          <p><b>The release candidate is ready for platform QA.</b></p>
          <p>What I verified:</p>
          <ul><li>Desktop checks passed.</li><li>Update metadata matches the release.</li><li>macOS installers are signed and notarized.</li></ul>
        </div>
        <MiniPaneComposer mode="Ask" />
      </section>

      <section class="chat-pane lower-pane">
        <header><strong>Compare provider integrations</strong><span class="pane-actions"><svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"></path></svg><svg viewBox="0 0 24 24"><path d="m6 6 12 12M18 6 6 18"></path></svg></span></header>
        <div class="chat-scroll">
          <p>I compared authentication, model support, and workspace integration across the selected providers.</p>
          <p><b>Next step:</b></p>
          <p>Verify browser and computer-use capabilities against each provider’s official documentation.</p>
          <p><b>Integration note:</b></p>
          <p>Keep provider-specific features visible without changing the common thread workflow.</p>
        </div>
        <MiniPaneComposer mode="Build" />
      </section>

      <section class="chat-pane lower-pane">
        <header><strong>Implement billing portal</strong><span class="pane-actions"><svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"></path></svg><svg viewBox="0 0 24 24"><path d="m6 6 12 12M18 6 6 18"></path></svg></span></header>
        <div class="chat-scroll">
          <p><b>Implementation plan</b></p>
          <ol><li>Add the customer portal route.</li><li>Validate the active workspace.</li><li>Open the provider-hosted billing session.</li><li>Add coverage for success and cancellation paths.</li></ol>
        </div>
        <MiniPaneComposer mode="Build" />
      </section>

      <section class="chat-pane new-thread-pane">
        <header><strong>New thread</strong><span class="pane-actions"><svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"></path></svg><svg viewBox="0 0 24 24"><path d="m6 6 12 12M18 6 6 18"></path></svg></span></header>
        <div class="new-thread-message">What should we build next?</div>
        <MiniPaneComposer mode="Build" current />
      </section>
    </main>
  </div>
</div>

<style>
  .multi-chat-viewport {
    --multi-scale: 1;
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .multi-chat-app {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 1440px;
    height: 900px;
    display: grid;
    grid-template-columns: 264px 1fr;
    overflow: hidden;
    color: #f5f5f5;
    background: rgba(19,19,19,.98);
    border: 1px solid rgba(255,255,255,.18);
    border-radius: 16px;
    box-shadow: 0 40px 90px rgba(0,0,0,.65);
    font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-size: 14px;
    line-height: 1.45;
    text-align: left;
    transform: translate(-50%, -50%) scale(var(--multi-scale));
    transform-origin: center;
  }

  .multi-chat-app * { box-sizing: border-box; }
  .multi-chat-app svg { fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }

  .multi-sidebar {
    min-width: 0;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: rgba(255,255,255,.045);
    border-right: 1px solid rgba(255,255,255,.1);
    backdrop-filter: blur(28px) saturate(1.25);
  }

  .traffic-lights { height: 52px; min-height: 52px; padding: 0 16px; display: flex; align-items: center; gap: 10px; }
  .traffic-lights i { width: 14px; height: 14px; border-radius: 50%; background: #ff5f57; }
  .traffic-lights i:nth-child(2) { background: #ffbd2e; }
  .traffic-lights i:nth-child(3) { background: #28c840; }

  .sidebar-nav { padding: 8px; display: grid; gap: 4px; }
  .sidebar-nav div, .project { height: 32px; padding: 0 8px; display: flex; align-items: center; gap: 8px; border-radius: 8px; color: rgba(255,255,255,.82); font-size: 14px; line-height: 1.625; }
  .sidebar-nav svg { width: 16px; height: 16px; flex: none; color: rgba(255,255,255,.5); }
  .sidebar-nav span { font-size: 14px; font-weight: 400; }
  .sidebar-scroll { min-height: 0; flex: 1; overflow: hidden; padding: 0 8px; }
  .sidebar-section { height: 32px; padding: 0 8px; display: flex; align-items: center; justify-content: flex-start; gap: 8px; color: rgba(255,255,255,.5); font-size: 14px; line-height: 1.625; }
  .sidebar-section .section-chevron { width: 16px; height: 16px; flex: 0 0 16px; transform: rotate(90deg); stroke-width: 2; }
  .sidebar-section.threads { margin-top: 12px; }
  .project { font-size: 14px; }
  .project + .project, .thread + .thread { margin-top: 2px; }
  .project.active { background: rgba(255,255,255,.06); }
  .project-icon { width: 16px; height: 16px; display: inline-flex; align-items: center; justify-content: center; flex: none; border-radius: 4px; font-size: 9px; font-style: normal; font-weight: 400; }
  .project-icon.orange { color: #ff9f43; background: rgba(255,159,67,.18); }
  .project-icon.mint { color: #72dfc2; background: rgba(114,223,194,.18); }
  .project-icon.violet { color: #ad85ff; background: rgba(173,133,255,.18); }
  .more { width: 16px; color: rgba(255,255,255,.48); font-size: 10px; letter-spacing: 1px; }
  .thread { width: 100%; height: 32px; padding: 0 8px; display: flex; align-items: center; gap: 6px; border-radius: 8px; color: rgba(255,255,255,.82); font-size: 14px; line-height: 1.625; }
  .thread span { min-width: 0; flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .thread time { flex: none; color: rgba(255,255,255,.5); font-size: 14px; line-height: 1.625; }
  .sidebar-settings { flex: none; padding: 8px 16px 12px; display: grid; grid-template-columns: 16px minmax(0,1fr); align-items: center; gap: 8px; color: rgba(255,255,255,.82); font-size: 14px; line-height: 1.625; }
  .sidebar-settings svg { display: block; width: 16px; height: 16px; color: rgba(255,255,255,.5); stroke-width: 2; }

  .pane-grid {
    min-width: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    grid-template-rows: 1fr 1fr;
    background: rgba(19,19,19,.98);
  }

  .chat-pane { position: relative; min-width: 0; min-height: 0; overflow: hidden; background: rgba(19,19,19,.98); border-right: 1px solid rgba(255,255,255,.09); border-bottom: 1px solid rgba(255,255,255,.09); }
  .chat-pane header { height: 52px; padding: 0 16px; display: flex; align-items: center; gap: 16px; border-bottom: 1px solid rgba(255,255,255,.09); }
  .chat-pane header strong { min-width: 0; flex: 1; overflow: hidden; color: rgba(255,255,255,.9); font-size: 14px; font-weight: 550; line-height: 1.625; text-overflow: ellipsis; white-space: nowrap; }
  .panel-symbol { width: 32px; height: 32px; display: inline-flex; align-items: center; justify-content: center; flex: none; color: rgba(255,255,255,.48); }
  .panel-symbol svg { width: 16px; height: 16px; }
  .pane-actions { display: flex; align-items: center; gap: 0; flex: none; color: rgba(255,255,255,.58); }
  .pane-actions svg { width: 32px; height: 32px; padding: 8px; stroke-width: 1.8; }
  .chat-scroll { position: absolute; inset: 52px 0 152px; overflow: hidden; padding: 20px 24px 32px; color: rgba(255,255,255,.82); font-size: 14px; line-height: 1.625; }
  .chat-scroll p, .chat-scroll ul, .chat-scroll ol { margin: 10px 0; }
  .chat-scroll .worked { margin-top: 0; color: rgba(255,255,255,.3); }
  .chat-scroll b { color: rgba(255,255,255,.9); font-weight: 550; }
  .chat-scroll ul, .chat-scroll ol { padding-left: 20px; }
  .chat-scroll li + li { margin-top: 4px; }
  .chat-scroll code { padding: 2px 6px; border: 1px solid rgba(255,255,255,.1); border-radius: 5px; background: rgba(255,255,255,.04); color: rgba(255,255,255,.9); font-family: "SF Mono", "JetBrains Mono", ui-monospace, monospace; font-size: 12px; line-height: 1.625; }
  .chat-scroll a { color: #58a6ff; text-decoration: underline; text-underline-offset: 2px; }
  .lower-pane { grid-row: 2; }
  .new-thread-pane { grid-column: 3; grid-row: 1 / span 2; border-right: 0; border-bottom: 0; }
  .new-thread-message { position: absolute; top: 43%; width: 100%; color: rgba(255,255,255,.3); font-size: 14px; font-weight: 550; line-height: 1.625; text-align: center; }

</style>

<script>
  const MULTI_DESIGN_WIDTH = 1440;
  const MULTI_DESIGN_HEIGHT = 900;
  const MULTI_INSET = 34;

  const resizeMultiChat = (viewport: HTMLElement) => {
    const scale = Math.min(
      Math.max(0, viewport.clientWidth - MULTI_INSET * 2) / MULTI_DESIGN_WIDTH,
      Math.max(0, viewport.clientHeight - MULTI_INSET * 2) / MULTI_DESIGN_HEIGHT,
    );
    viewport.style.setProperty("--multi-scale", String(scale));
  };

  const multiViewports = document.querySelectorAll<HTMLElement>("[data-multi-chat-viewport]");
  const multiObserver = new ResizeObserver((entries) => {
    for (const entry of entries) resizeMultiChat(entry.target as HTMLElement);
  });
  for (const viewport of multiViewports) {
    resizeMultiChat(viewport);
    multiObserver.observe(viewport);
  }
</script>
