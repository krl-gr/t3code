---
interface Props {
  mode?: "Ask" | "Build";
  placeholder?: string;
  current?: boolean;
}

const {
  mode = "Build",
  placeholder = "Ask for follow-up changes or attach images",
  current = false,
} = Astro.props;
---

<div class="pane-composer-wrap">
  <div class="pane-composer">
    <div class="composer-placeholder">{placeholder}</div>
    <div class="composer-toolbar">
      <div class="composer-options">
        <span class="icon-control">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"></path></svg>
        </span>
        <i></i>
        <span class="icon-control">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 6a9 9 0 0 0-9 9V3"></path><circle cx="18" cy="6" r="3"></circle><circle cx="6" cy="18" r="3"></circle></svg>
        </span>
        <i></i>
        <span>{mode}</span>
        <i></i>
        <span>Full access</span>
        <i></i>
        <span>•••</span>
      </div>
      <span class="send-button">
        <svg viewBox="0 0 14 14" aria-hidden="true"><path d="M7 11.5V2.5M7 2.5 3 6.5M7 2.5l4 4"></path></svg>
      </span>
    </div>
  </div>

  <div class="context-bar">
    <div class="context-left">
      <span class="context-icon project-context"><b>T</b></span>
      <svg class="context-slash" viewBox="0 0 6 12" aria-hidden="true"><path d="M5.25 0.5L0.75 11.5"></path></svg>
      <span class="context-text checkout-context">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"></path></svg>
        <span>{current ? "Current checkout" : "Local checkout"}</span>
      </span>
      <i class="context-separator"></i>
      <span class="context-text branch-name">orchestra...</span>
    </div>
    <div class="context-actions">
      <span class="context-text commit-action">Commit</span>
      <i class="context-separator"></i>
      <span class="context-icon more-action" aria-label="More actions">
        <svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="4" cy="8" r="1"></circle><circle cx="8" cy="8" r="1"></circle><circle cx="12" cy="8" r="1"></circle></svg>
      </span>
    </div>
  </div>
</div>

<style>
  .pane-composer-wrap {
    position: absolute;
    z-index: 3;
    right: 20px;
    bottom: 0;
    left: 20px;
    height: 152px;
    color: rgba(255,255,255,.5);
    font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-size: 14px;
    line-height: 1.625;
  }

  .pane-composer-wrap * { box-sizing: border-box; }
  .pane-composer-wrap svg { fill: none; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; }

  .pane-composer {
    height: 112px;
    min-height: 96px;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: 32px;
    background: #1e1e1e;
    box-shadow: inset -1px -1px 1px rgba(255,255,255,.06), inset 1px 1px 1px rgba(255,255,255,.12), 0 4px 14.4px rgba(9,9,9,.08);
  }

  .composer-placeholder {
    min-width: 0;
    min-height: 0;
    flex: 1;
    padding: 24px 24px 0;
    overflow: hidden;
    color: rgba(255,255,255,.5);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .composer-toolbar {
    height: 48px;
    padding: 0 16px 16px;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .composer-options {
    min-width: 0;
    flex: 1;
    display: flex;
    align-items: center;
    gap: 2px;
    overflow: hidden;
    white-space: nowrap;
  }

  .composer-options > span {
    height: 32px;
    padding: 0 8px;
    display: inline-flex;
    align-items: center;
    flex: none;
  }

  .composer-options > .icon-control {
    width: 32px;
    padding: 0;
    justify-content: center;
  }

  .composer-options svg { width: 16px; height: 16px; stroke-width: 2; }
  .composer-options i, .context-separator { width: 1px; height: 12px; flex: none; background: rgba(255,255,255,.06); }

  .send-button {
    width: 32px;
    height: 32px;
    display: inline-grid;
    place-items: center;
    flex: none;
    border-radius: 50%;
    background: #d4d4d4;
    color: #171717;
    opacity: .4;
    box-shadow: inset 0 -1px 1px rgba(0,0,0,.17), inset 0 1px 1px #fff;
  }

  .send-button svg { width: 14px; height: 14px; stroke-width: 1.8; }

  .context-bar {
    height: 40px;
    padding: 4px 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    filter: drop-shadow(0 4px 2px rgba(0,0,0,.25));
  }

  .context-left, .context-actions {
    min-width: 0;
    display: flex;
    align-items: center;
    overflow: hidden;
    white-space: nowrap;
  }

  .context-left { flex: 1; }
  .context-actions { flex: none; }
  .context-icon { width: 32px; height: 32px; display: inline-flex; align-items: center; justify-content: center; flex: none; }
  .project-context b { width: 16px; height: 16px; display: inline-grid; place-items: center; border-radius: 4px; color: #ff9f43; background: rgba(255,159,67,.18); font-size: 9px; font-weight: 400; }
  .context-slash { width: 6px; height: 12px; flex: none; color: rgba(255,255,255,.06); }
  .context-slash path { stroke-width: 1; }
  .context-text { height: 32px; min-width: 0; padding: 0 8px; display: inline-flex; align-items: center; gap: 4px; flex: none; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .context-text svg { width: 14px; height: 14px; flex: none; stroke-width: 2; }
  .checkout-context { max-width: 128px; }
  .branch-name { max-width: 84px; flex: 1; }
  .commit-action { padding-inline: 8px; }
  .more-action svg { width: 16px; height: 16px; stroke-width: 1.3; }
  .more-action circle { fill: currentColor; stroke: none; }
</style>
